  "structuredContent": {
    "translations": [
      {
        "targetLang": "MY",
        "translations": [
          {
            "detectedSourceLanguage": "EN",
            "text": "စင်တောမျိုးနွယ်စုများစွာက စင်တောမျိုးကို ဖွဲ့စည်းထားသည်။  တိုင်းစုတိုင်းတွင် ကိုယ်ပိုင်ခေါင်းဆောင်နှင့် ရည်ရွယ်ချက်ရှိသော်လည်း၊ မျိုးနွယ်စုအားလုံးတွင် တစ်ခုတည်းသော အချက်တစ်ခုရှိသည်။  အကြမ်းဖက်မှု။\n\nငြိမ်းချမ်းရေးကို တစ်ခါတစ်ရံ ရရှိစေရန်ဆိုပါက၊ စင်တောများကို ဖယ်ရှားပစ်ရမည်။  ထို့ကြောင့် ငါသည် သင့်အား ထိုတာဝန်ကို ဆောင်ရွက်ရန် ခန့်အပ်လိုက်သည်။\n\nဒက်ဆိုလေးစ်ဒေသကို လှည့်လည်သွားရင်း စင်တာများကို သတ်၍ သူတို့၏ နားများကို ယူပါ။ နားများ အများကြီး ယူလာပါ။\n\nဤတာဝန်ကို အလိုင်ယန့်စ်အတွက်၊ <name> အတွက် ဆောင်ရွက်ပါက ကျွန်ုပ်တို့သည် စစ်ပွဲအဆုံးသတ်ဆီသို့ တစ်ခြေလှမ်း နီးကပ်လာမည်။"
          },
          {
            "detectedSourceLanguage": "EN",
            "text": "ဒက်ဆိုလေ့စ်ရှိ နိုင်ဂျယ်စ် ပွိုင့်တွင် တပ်သား မဲလ်ကင်ထံ ဆင်နတ်နား ၁၅ လုံး ယူဆောင်သွားပါ။"
          },
          {
            "detectedSourceLanguage": "EN",
            "text": "<name>၊ သင့်မှာ အစီရင်ခံစာ ရှိပါသလား?"
          },
          {
            "detectedSourceLanguage": "EN",
            "text": "အာ၊ နားတွေ။ ကောင်းပြီ။\n\nမင်းရဲ့ မဟာမိတ်အဖွဲ့အတွက် ဝန်ဆောင်မှုက မေးခွန်းမရှိပါဘူး၊ <name>။ မင်း Desolace မှာ စွန့်ခဲ့တဲ့ သွေးက မခွဲမခွာ လူအများ၏ အသက်များကို ကယ်တင်ပေးမှာပါ။"
          }
        ]
      }
    ],
