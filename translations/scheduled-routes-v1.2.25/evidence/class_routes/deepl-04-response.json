  "structuredContent": {
    "translations": [
      {
        "targetLang": "MY",
        "translations": [
          {
            "detectedSourceLanguage": "EN",
            "text": "ကျွန်ုပ်သည် Cyclonian ကို ခေါ်ယူရန် အခမ်းအနား ပြုလုပ်ရန် အသင့်ဖြစ်ပါပြီ။  သူကို ခေါ်ယူပြီးနောက် သင်သည် သူအား အနိုင်ယူကာ သူ၏ လေပြင်းနှလုံးကို ယူရမည်။  ဤကို ကျွန်ုပ်သည် Cyclonian ၏ အင်အားဖြင့် လက်နက်တစ်စင်းအား ထည့်သွင်းရန် အသုံးပြုမည်။\n\n<name>၊ လေဘုရင်နှင့် ရင်ဆိုင်ရန် သင် အသင့်ပြင်ထားပါသလား?"
          },
          {
            "detectedSourceLanguage": "EN",
            "text": "လေပြင်းနှလုံးကို Bath'rah Windwatcher ဆီ ယူဆောင်သွားပါ။"
          },
          {
            "detectedSourceLanguage": "EN",
            "text": "<name>၊ ငါ့မှာ လေပြင်းကဲ့သို့ လှုပ်ရှားနေတဲ့ နှလုံးသားတစ်ခု ရှိရမယ်။"
          },
          {
            "detectedSourceLanguage": "EN",
            "text": "မင်းလုပ်နိုင်ခဲ့ပြီ!  မင်းက ဆိုင်ကလိုနီယန်ကို အနိုင်ယူပြီး လေပြင်းနှလုံးကို ရရှိခဲ့ပြီ!"
          },
          {
            "detectedSourceLanguage": "EN",
            "text": "လေပြင်းလက်နက်"
          },
          {
            "detectedSourceLanguage": "EN",
            "text": "ကျွန်ုပ်တွင် လေပြင်းနှလုံးရှိပြီး၊ သင်ရွေးချယ်ထားသော သိုလှောင်ပုံးထဲသို့ ထည့်ရန် အသင့်ဖြစ်ပါသည်။\n\nသင့်လက်နက်ကို ရွေးပါ၊ <name>၊ ၎င်း၏ အင်အားမှာ စိုင်ကလိုနီယန်၏ အင်အားဖြစ်ကြောင်း သိထားပါ။"
          },
          {
            "detectedSourceLanguage": "EN",
            "text": "နှင်ထုတ်ခံရသူ၏ အနှစ်သာရ"
          },
          {
            "detectedSourceLanguage": "EN",
            "text": "အိုးကြီးသည် ဖုတ်ဖုတ်ဆူနေသည်။ ၎င်း၏ အငွေ့များက ဆွဲဆောင်နေသည်..."
          },
          {
            "detectedSourceLanguage": "EN",
            "text": "အဆောင်များသည် အိုးကြီး၏ အနက်ဆုံးထဲသို့ တဖြည်းဖြည်း နစ်မြုပ်သွားသည်...\n\nအရည်၏ မျက်နှာပြင်ပေါ်သို့ အကြီးမားသော ရေဖုတ်တစ်ခု တက်လာကာ ပေါက်ကွဲသွားသည်...\n\n...ထို့နောက် လှုပ်ရွားနေသော ပူပြင်းကျောက်အထုတစ်ခု ပေါ်လွင်လာသည်။"
          }
        ]
      }
    ],
