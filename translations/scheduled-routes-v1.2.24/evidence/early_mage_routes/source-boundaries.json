    "uaVariants": [
      {
        "title": "Верховний чаклун Андромат",
        "detail": "Верховний чаклун Андромат бажає поговорити з тобою, {ім'я:к}. Він знаходиться на верхньому поверсі вежі магів, в районі магів Штормовія.\n\nБуло б мудро поговорити з ним, оскільки Андромат є одним з наймогутніших магів за межами Даларана. Його поради високо цінуються.",
        "objective": "Поговоріть з верховним чаклуном Андроматом.",
        "progress": null,
        "complete": "Вітаю, {ім'я:к}. Я радий бачити тебе і сподіваюсь, що у тебе є час послухати слова старця...",
        "en": "High Sorcerer Andromath",
        "faction": "Both"
      }
    ],
