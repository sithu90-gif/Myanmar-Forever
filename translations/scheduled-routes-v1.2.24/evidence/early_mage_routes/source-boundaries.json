    "uaVariants": [
      {
        "title": "Розмова з Дейно",
        "detail": "Трольці-магині Дейно потрібна твоя допомога, {ім'я:к}. Вона знаходиться в Орґріммарі, в хижі Темношипа.",
        "objective": "Поговоріть з Дейно.",
