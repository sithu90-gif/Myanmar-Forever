    {
      "id": 532,
      "field": "objective",
      "sourceEnglish": "Kill Magistrate Burnside and 5 Hillsbrad Councilmen.  Destroy the Hillsbrad Proclamation.  Steal the Hillsbrad Town Registry.  Report back to Darthalia in Tarren Mill afterwards.",
      "priorMyanmarSHA256": "484885733003294b2ddeb775a7556bd577a109b9db02430bf5a8cdfd36fe7361",
