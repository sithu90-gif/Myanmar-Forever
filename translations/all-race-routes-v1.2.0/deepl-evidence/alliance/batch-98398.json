    "structuredContent": {
      "translations": [
        {
          "targetLang": "MY",
          "translations": [
            {
              "detectedSourceLanguage": "EN",
              "text": "အိုရာကယ် သစ်ပင်"
            },
            {
              "detectedSourceLanguage": "EN",
              "text": "၎င်း၏ သတင်းစကားကို လက်ခံရန် အနီးအနားရှိ Oracle သစ်ခွံကို ရှာပါ။"
            },
            {
              "detectedSourceLanguage": "EN",
              "text": "သင်ကျသွားသော သစ်ခွံကို စစ်ဆေးနေစဉ်၊ အသံတစ်ခု သင့်စိတ်ထဲသို့ ဝင်လာသည်။ ၎င်းအသံသည် တည်ငြိမ်ပြီး စိတ်အေးစေကာ၊ သစ်ရွက်များကြားမှ ဖြတ်သန်းလာသည့် နူးညံ့သော လေလှိုင်းကဲ့သို့ သင့်ကို ဖုံးလွှမ်းသည်။"
            },
            {
              "detectedSourceLanguage": "EN",
              "text": "<name>၊ မင်းက ဒီမှာ အချိန်တိုအတွင်း အံ့သြဖွယ် အောင်မြင်မှုတွေ ရရှိထားတာကို ကြည့်ပြီး ကျွန်ုပ် အံ့အားသင့်နေပါသည်။ မင်းကို ဒီမှာ ကျန်နေပြီး ကျွန်ုပ်၏ တာဝန်များတွင် ကူညီပေးစေလိုသော်လည်း၊ မင်းအတွက် ပိုမိုကြီးမားသော တာဝန်များ ရှေ့တွင် စောင့်ဆိုင်းနေကြောင်း ကျွန်ုပ်နှလုံးသားက သိမြင်နေပါသည်။\n\nကျွန်ုပ် သတိပြုမိတာက Oracle သစ်ပင်က မကြာသေးခင်က ၎င်း၏ သစ်ခွံတစ်စိတ်ကို ကျွတ်ကျခဲ့တာပါ။ အဲဒီသစ်ပင်မှာ ပြီးမြောက်စေလိုတဲ့ တာဝန်တစ်ခု ရှိနေမှာ သေချာပါသည်။ မင်းက အဲဒီသစ်ပင်နဲ့ စကားပြောသင့်ပါသည်။"
            }
          ]
        }
