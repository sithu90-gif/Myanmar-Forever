    "structuredContent": {
      "translations": [
        {
          "targetLang": "MY",
          "translations": [
            {
              "detectedSourceLanguage": "EN",
              "text": "ဓားကို ပိုလှည့်ခြင်း"
            },
            {
              "detectedSourceLanguage": "EN",
              "text": "ကရိုကိုလစ်စ် ဒက်ဂဲဖန့်ကို ရှာတွေ့ပြီး အနိုင်ယူကာ မာရေးခ်ရဲ့ဓားကို ပြန်ယူပါ။"
            },
            {
              "detectedSourceLanguage": "EN",
              "text": "အမဲလိုက်တာ ဘယ်လိုဖြစ်နေလဲ?"
            },
            {
              "detectedSourceLanguage": "EN",
              "text": "ဟား! မင်းလုပ်နိုင်ပြီ! အဲဒီဟောင်းကရိုကိုဒိုင်းက ပြန်ဒဏ်ခံရမယ်လို့ မထင်ခဲ့ဘူး၊ ဒါပေမယ့် ဒီနည်းက အဆင်ပြေသွားပြီ!\n\nအို အာ... မင်းသိလား၊ ငါ့အတွက် ဓားအသစ်တစ်လက် ဝယ်ရခဲ့တယ်၊ ဒါပေမယ့် အဲဒီဓားက မင်းကို ကံကောင်းစေမယ်ထင်တယ်။ မင်းက ကိုင်ထားမလား?"
            },
            {
              "detectedSourceLanguage": "EN",
              "text": "ငါ crocolisk တစ်ကောင်ကြောင့် လက်တစ်ဖက်နီးပါးဆုံးရှုံးမယ်ဆိုတာ မင်းကို ပြောဖူးလား။ ဓားကို သူ့ပါးစပ်ထဲထိုးပြီး အမြန်ထွက်နိုင်ခဲ့တယ်။ ဓားကို ဒီမှာတစ်နေရာမှာထားခဲ့တယ်ထင်ပေမယ့် မတွေ့တော့ဘူး။\n\nဘာပဲဖြစ်ဖြစ်၊ အဲ့ဒီမြွေငါးက ရေကန်ဘေးမှာ အခုတောင် အမဲလိုက်နေလိမ့်မယ်။ အဲ့ဒီဆိုးရွားတဲ့ကောင်ကို အခြားအမဲလိုက်သူတွေအတွက် လုံခြုံရေးအတွက်ဖြစ်စေ၊ ဘာဖြစ်စေ ဖယ်ရှားပစ်ဖို့လိုတယ်။\n\nငါက အဲဒီကရိုကို Daggerfang လို့ ခေါ်နေတယ်။ မင်းမြင်ရင် ငါ့ဘက်ကနေ မင်္ဂလာပါလို့ ပြောပေးပါ! ဟုတ်ကဲ့၊ \"မင်္ဂလာပါ\" ဆိုတာက \"ဓားထိုး\" ဆိုလိုတာပါ။"
            }
          ]
        }
      ],
