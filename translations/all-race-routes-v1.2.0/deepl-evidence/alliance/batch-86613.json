    "structuredContent": {
      "translations": [
        {
          "targetLang": "MY",
          "translations": [
            {
              "detectedSourceLanguage": "EN",
              "text": "တူးဖော်ကိရိယာများ"
            },
            {
              "detectedSourceLanguage": "EN",
              "text": "Magmar Fellhew ဆီသို့ တူးဖော်ကိရိယာ ၆ ခု ပြန်ပို့ပါ။"
            },
            {
              "detectedSourceLanguage": "EN",
              "text": "ကျွန်တော်တို့က ဒီ တူးဖော်နေတဲ့ နေရာကို ပြင်ဆင်ရုံနဲ့ ဒီအရာအားလုံးကို ပြန်လမ်းကြောင်းမှန်ပေါ် ပြန်တင်နိုင်မှာပဲ။"
            },
            {
              "detectedSourceLanguage": "EN",
              "text": "ကျွန်ုပ်တို့ရဲ့ ကိရိယာတွေ!\n\nထရော့ဂ်တွေက စခန်းကို တိုက်ခိုက်ကျူးကျော်လာတဲ့အခါ ကျွန်ုပ်တို့က ကိရိယာအများစုကို နောက်မှာ ထားခဲ့ရတယ်။ ဒီကျူးကျော်မှုကို ထိန်းချုပ်နိုင်ပြီး ပြန်လည်အလုပ်စတင်နိုင်လာတဲ့အခါ ဒါက အရမ်းအကူအညီဖြစ်မယ်။"
            },
            {
              "detectedSourceLanguage": "EN",
              "text": "ထွော့ဝ်များသည် ထရော့ဂ်များထံမှ ထွက်ပြေးသွားစဉ် ကျန်ခဲ့သော တူးဖော်ရေးကိရိယာများသည် အများအားဖြင့် မထိခိုက်သေးပေ။ ထိုကိရိယာများကို တူးဖော်သူများထံ ပြန်လည်ပေးအပ်ခြင်းက သူတို့၏ အလုပ်ကို အကူအညီဖြစ်စေမည်မှာ သေချာပါသည်။"
            }
          ]
        }
      ],
