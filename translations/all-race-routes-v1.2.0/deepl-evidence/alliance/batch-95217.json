    "structuredContent": {
      "translations": [
        {
          "targetLang": "MY",
          "translations": [
            {
              "detectedSourceLanguage": "EN",
              "text": "The Quarry ရဲ့ စမစ်"
            },
            {
              "detectedSourceLanguage": "EN",
              "text": "ကြေးနီဘား ၁၂ ချောင်းနှင့် ခိုင်ခံ့သော ဝက်အရေခွံ ၄ ခုကို စုဆောင်းပြီး Frast Dokner ထံ ပို့ဆောင်ပါ။"
            },
            {
              "detectedSourceLanguage": "EN",
              "text": "မပျင်းပါနဲ့၊ <name>။ သံမဏိလုပ်ခြင်းဟာ ပျင်းတဲ့သူတွေအတွက် မဟုတ်ဘူး။"
            },
            {
              "detectedSourceLanguage": "EN",
              "text": "မင်းက အရင်းအမြစ်ရှာတတ်သူတစ်ယောက်ပါ၊ <name>။\n\nအခုတော့ နားထောင်ပါ - ငါ ပြန်မပြောတော့ဘူး!"
            },
            {
              "detectedSourceLanguage": "EN",
              "text": "သံမဏိလုပ်ငန်းကို သင်ယူချင်တာလား။ ကျွန်တော်တို့ အပြန်အလှန် ကူညီနိုင်မယ်ထင်တယ်။\n\nပစ္စည်းပို့ဆောင်ရေးနောက်ကျနေပြီး စခန်းအတွင်း ပြုပြင်ထိန်းသိမ်းရေးအတွက် လိုအပ်တဲ့ ပစ္စည်းတွေရှိတယ်။ မင်းလိုအပ်တာတွေကို ရယူပေးနိုင်ရင် ကျွန်တော့်နည်းလမ်းတချို့ကို သင်ပေးမယ်။ ကောင်းလား။"
            }
          ]
        }
      ],
