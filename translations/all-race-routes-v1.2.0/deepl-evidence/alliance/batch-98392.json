    "structuredContent": {
      "translations": [
        {
          "targetLang": "MY",
          "translations": [
            {
              "detectedSourceLanguage": "EN",
              "text": "တောလယ်ထဲမှ မှောင်မိုက်"
            },
            {
              "detectedSourceLanguage": "EN",
              "text": "အိုရေးကယ်လ်မြက်ခင်း၌ စောင့်ကြည့်သူ အာနီးနီးယာ ကလောဒ်စ်ဘရိတ်အတွက် Hatescreech ၏ အမူလက်၊ Windmistress Gaedress ၏ အမူလက်နှင့် Witchmother Arysa ၏ အမူလက်ကို စုဆောင်းပါ။"
            },
            {
              "detectedSourceLanguage": "EN",
              "text": "သင်သည် ဟပ်ပရီများ၏ ခေါင်းဆောင်များထံမှ အမူလက်များကို ဆွဲယူနိုင်ခဲ့ပါသလား?"
            },
            {
              "detectedSourceLanguage": "EN",
              "text": "<Arynia သည် မုဒိန်များကို စုံစမ်းစစ်ဆေးနေသည်။>\n\nရတနာများအတွင်းရှိ မကောင်းဆိုးရွားသော အစိမ်းရောင် လှိုင်းပတ်များကို မြင်ပါသလား။ ဤသည်မှာ အမှန်တကယ် မကောင်းဆိုးရွားသော သစ်ကွင်းပိုးကပ်ခြင်း၏ လှုပ်ရှားမှုပင် ဖြစ်သည်။\n\nShadowglen နှင့် ဤပစ္စည်း၏ အခြားအခွဲများမှလည်း ဤပစ္စည်းသည် ကျွန်ုပ်တို့၏ ကမ္ဘာကြီးကို ကျွန်ုပ်တို့ကိုယ်တိုင် ဆန့်ကျင်အောင် ပြောင်းလဲနေကြောင်း ဆင်တူသတင်းများ ကြားဖူးပါသည်။\n\nဤအကြောင်းကို ချက်ချင်း ကျွန်ုပ်၏ အထက်တန်းအရာရှိများအား အသိပေးမည်။"
            },
            {
              "detectedSourceLanguage": "EN",
              "text": "ဒီခါးပတ်တွေ... အသားအရေကို နီးကပ်စွာကြည့်ပါ၊ <name>။ အမျှင်တွေအတွင်းမှာ မည်းညိုနေတဲ့ အရောင်တစ်ခု ဖြတ်သန်းနေသလို မြင်ရလား။\n\n၎င်းရဲ့ မူလအစကို ငါ ခန့်မှန်းထားပေမယ့်၊ သေချာဖို့ ထပ်မံသက်သေတွေ လိုအပ်နေပါသည်။\n\nအနောက်ဘက်ရှိ ဟပ်ပရီတွေရဲ့ အိမ်ထဲကို ပြန်သွားပြီး သူတို့ခေါင်းဆောင်တွေကို ဖျက်ဆီးလိုက်ပါ။ သူတို့ရဲ့ လည်ဆွဲတွေမှာ ဒီခါးပတ်တွေလိုပဲ မှောင်မိုက်မှုရှိနေခဲ့ရင် ကျွန်တော်တို့ရဲ့ ဖြေရှင်းချက်ကို ရရှိပါလိမ့်မယ်။"
            }
          ]
        }
      ],
      "ignoredParameters": [
        "context"
      ]
